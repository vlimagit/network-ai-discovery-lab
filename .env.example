# Copy to .env and replace values locally. NEVER commit .env.

# LLM: groq | openrouter | local (used in later phases)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=
OPENROUTER_API_KEY=
LOCAL_LLM_BASE_URL=

# NetBox (configured in the next phase)
NETBOX_URL=http://127.0.0.1:8000
NETBOX_TOKEN=
NETBOX_ADMIN_USER=admin
NETBOX_ADMIN_PASSWORD=

# Network discovery (read-only at first; never sent to the LLM)
NETWORK_USERNAME=admin
NETWORK_PASSWORD=
NETWORK_SSH_PORT=22
NETWORK_SSH_TIMEOUT=10

# Runtime mode: virtual | physical
LAB_MODE=virtual
CONTAINERLAB_TOPOLOGY=infra/containerlab/topology.clab.yml
